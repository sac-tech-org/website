{
  "name": "sac-tech-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:next": "next dev",
    "email:dev": "email dev --dir emails --port 3001",
    "build": "next build",
    "start": "next start",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "netlify database migrations apply",
    "db:status": "netlify database status",
    "auth:generate": "BETTER_AUTH_SCHEMA_GENERATION=1 auth generate --config ./lib/auth-config.ts --output ./db/auth-schema.ts --yes",
    "auth:create-admin": "auth create-admin --config ./lib/auth-config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@lexical/code": "0.49.0",
    "@lexical/link": "0.49.0",
    "@lexical/list": "0.49.0",
    "@lexical/markdown": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/rich-text": "0.49.0",
    "@lexical/selection": "0.49.0",
    "@netlify/database": "^2.0.0",
    "@netlify/functions": "^5.3.0",
    "@react-email/render": "^2.1.0",
    "better-auth": "1.7.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "1.0.0-rc.4",
    "lexical": "0.49.0",
    "next": "^16.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-email": "^6.9.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "^6.20.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.0",
    "@react-email/ui": "6.9.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "5.0.0-beta.7",
    "@vitest/browser-playwright": "5.0.0-beta.7",
    "auth": "^1.7.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.31.0",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "10.1.8",
    "netlify-cli": "^27.1.2",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "5.0.0-beta.7"
  },
  "pnpm": {
    "patchedDependencies": {
      "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch"
    }
  }
}
