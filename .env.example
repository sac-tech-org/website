# Netlify Database injects NETLIFY_DB_URL automatically. Do not commit it here.
BETTER_AUTH_SECRET=

# Recommended local overrides. Netlify deployments derive these automatically.
BETTER_AUTH_URL=http://localhost:8888
BETTER_AUTH_ALLOWED_HOSTS=localhost:3000,localhost:8888,127.0.0.1:3000,127.0.0.1:8888

# Server-only Resend credentials for account and admin-digest emails.
# The sender must use a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_INVITE_LINK=
